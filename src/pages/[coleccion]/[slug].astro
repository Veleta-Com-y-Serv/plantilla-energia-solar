---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /soluciones/<slug>/.
// Mismo lenguaje que la portada: banda verde noche con celdas, migas y titular en minúscula con el sol del
// icono (o la foto a la derecha con esquinas redondeadas); banda blanca con el `detalle`, la tabla de datos y la
// caja amarilla de estudio gratis; fotos (`imagenes`) en banda menta; y otras soluciones en banda verde noche.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const estudio = seccion('presupuesto') ? '/#presupuesto' : site.boton_cabecera?.url || '/#contacto';
const textoEstudio = 'Pide tu estudio gratis';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-noche celdas ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion ficha-titulo">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio-pastilla">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={estudio}>{textoEstudio} <Icono nombre="flecha" tam={20} /></a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-sol" aria-hidden="true"><Icono nombre={f.icono || 'panel'} tam={88} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda-clara seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda-sol">
          <p class="ficha-cita-titulo">¿Cuánto ahorrarías?</p>
          <p>Con tu factura de la luz calculamos la instalación y el ahorro, sin compromiso.</p>
          <a class="btn" href={estudio}>{textoEstudio}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-menta seccion" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-noche celdas seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras soluciones" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'panel'} tam={36} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-pastilla">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todas las soluciones</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5.5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .85rem; font-weight: 700; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; color: var(--c-acento); }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; opacity: .85; }
  .migas a:hover { text-decoration: underline; opacity: 1; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-titulo { font-size: clamp(2.5rem, 8vw, 5.5rem); overflow-wrap: anywhere; }
  .ficha-precio-pastilla { display: inline-flex; margin-top: 1.5rem; padding: .4rem 1rem; border-radius: 999px; font-weight: 800; background: var(--c-acento); color: var(--sobre-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: 1.25rem; overflow: hidden; background: var(--noche-2); }
  .ficha-sol { display: grid; place-items: center; width: min(100%, 22rem); aspect-ratio: 1; margin-inline: auto; border-radius: 50%; background: var(--c-acento); color: var(--sobre-acento); box-shadow: 0 0 0 1.5rem color-mix(in srgb, var(--c-acento) 30%, transparent), 0 0 0 3.5rem color-mix(in srgb, var(--c-acento) 14%, transparent); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.3rem; font-weight: 600; margin-top: 0; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.35rem; margin-bottom: 1rem; }
  .ficha-datos { border-top: 4px solid var(--c-primario); background: var(--menta); border-radius: 0 0 var(--radio) var(--radio); padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.2rem; color: var(--c-primario); }
  .ficha-cita { display: grid; gap: .9rem; border-radius: 1.25rem; padding: 1.75rem 1.5rem; justify-items: start; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.9rem; font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: 1.25rem; overflow: hidden; }
  .ficha-otras { display: grid; gap: 1px; background: color-mix(in srgb, currentColor 20%, transparent); border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: 1.25rem; overflow: hidden; }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.75rem 1.5rem; background: var(--noche); transition: background-color .2s ease; min-width: 0; }
  .ficha-otra:hover { background: color-mix(in srgb, var(--noche) 88%, var(--c-acento)); }
  .ficha-otra-icono { color: var(--c-acento); }
  .ficha-otra h3 { font-size: 1.4rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: -3px; }
  .ficha-otra p { opacity: .82; }
  .ficha-otra-pie { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-top: auto; padding-top: .75rem; opacity: 1 !important; }
  .ficha-pastilla { padding: .3rem .8rem; border-radius: 999px; font-weight: 800; font-size: .9rem; background: var(--c-acento); color: var(--sobre-acento); }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; color: var(--c-acento); }
  @media (min-width: 768px) { .ficha-otras { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
