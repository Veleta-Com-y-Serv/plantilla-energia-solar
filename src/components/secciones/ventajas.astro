---
// Ventajas: banda clara con titular partido y `items: [{titulo, texto, icono}]` en columnas separadas por filetes
// (4 en escritorio, 2 en tableta, 1 en móvil), cada una con su icono en un sol pequeño. Sin tarjetas.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
---

{
  s && (items.length > 0 || s.titulo || s.texto) && (
    <section id={Astro.props.id} class="seccion banda-clara">
      <div class="contenedor">
        <Titular partido antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto}>
          {s.cta && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
        </Titular>
        {items.length > 0 && (
          <ul class="ventajas" style={`--cols:${Math.min(items.length, 4)}`}>
            {items.map((it) => (
              <li class="ventaja">
                <span class="disco"><Icono nombre={it.icono || 'sol'} tam={26} /></span>
                <div>
                  <h3 class="text-[1.3rem] md:text-2xl">{it.titulo}</h3>
                  {it.texto && <p class="mt-2 opacity-80">{it.texto}</p>}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .ventajas { display: grid; border-top: 1px solid var(--linea); }
  .ventaja { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: start; padding: 1.6rem 0; border-bottom: 1px solid var(--linea); min-width: 0; }
  @media (min-width: 640px) {
    .ventajas { grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 0; }
    .ventaja { grid-template-columns: 1fr; gap: 1.5rem; padding: 2.25rem 2rem 2.5rem; border-bottom: 0; border-left: 1px solid var(--linea); }
  }
  @media (min-width: 1024px) {
    .ventajas { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .ventaja { padding: 1rem 2.25rem 1.5rem; }
  }
</style>
