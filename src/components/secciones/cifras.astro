---
// Cifras: banda verde a todo el ancho con números enormes separados por filetes. `items: [{titulo (la cifra,
// "+450"), texto}]`. No se pinta si la lista está vacía (la plataforma nunca inventa cifras).
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
---

{
  s && items.length > 0 && (
    <section id={Astro.props.id} class="seccion banda-verde cifras-banda">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        <dl class="cifras" style={`--cols:${Math.min(items.length, 4)}`}>
          {items.map((it) => (
            <div class="cifra">
              <dt class="cifra-numero">{it.titulo}</dt>
              {it.texto && <dd class="cifra-texto">{it.texto}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .cifras-banda { position: relative; overflow: hidden; }
  .cifras-banda::before { content: ""; position: absolute; width: 26rem; aspect-ratio: 1; right: -8rem; top: -12rem; border-radius: 50%; background: var(--c-acento); opacity: .9; pointer-events: none; display: none; }
  @media (min-width: 1100px) { .cifras-banda::before { display: block; } }
  .cifras-banda > :global(.contenedor) { position: relative; }
  .cifras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cifra { padding: 1.5rem 1rem 1.5rem 0; border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent); min-width: 0; }
  @media (min-width: 900px) {
    .cifras { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .cifra { padding: .5rem 1.5rem 1rem; border-top: 0; border-left: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  }
  .cifra-numero { font-family: var(--fuente-titulos); font-weight: 800; font-size: clamp(2.4rem, 5.4vw, 5rem); line-height: .95; letter-spacing: -0.05em; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .cifra-texto { margin-top: .75rem; font-weight: 600; font-size: 1.05rem; opacity: .9; }
</style>
