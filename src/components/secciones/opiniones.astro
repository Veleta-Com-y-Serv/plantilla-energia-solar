---
// Opiniones: banda menta con titular centrado y `testimonios: [{texto, autor, nota}]` en columnas separadas por
// filetes, sin tarjetas: comilla grande en un sol, cita en letra grande y autor. `nota` opcional (trabajo y pueblo).
// Sin opiniones solo se pinta el titular (o nada si tampoco hay).
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = s ? s.testimonios.filter((t) => t && t.texto) : [];
const hayAlgo = s && (lista.length > 0 || s.titulo || s.texto);
---

{
  s && hayAlgo && (
    <section id={Astro.props.id} class="seccion banda-menta">
      <div class="contenedor">
        <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {lista.length > 0 && (
          <ul class="opiniones" style={`--cols:${Math.min(lista.length, 3)}`}>
            {lista.map((t) => (
              <li class="opinion">
                <span class="opinion-comilla" aria-hidden="true">“</span>
                <blockquote class="opinion-texto">{t.texto}</blockquote>
                <p class="mt-6 font-display text-lg font-extrabold tracking-tight">{t.autor}</p>
                {t.nota && <p class="text-[.95rem] opacity-70">{t.nota}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .opiniones { display: grid; }
  .opinion { display: flex; flex-direction: column; padding: 2rem 0; border-top: 1px solid var(--linea); min-width: 0; }
  @media (min-width: 900px) {
    .opiniones { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .opinion { padding: .5rem 2.5rem 1rem; border-top: 0; border-left: 1px solid var(--linea); }
    .opinion:first-child { border-left: 0; padding-left: 0; }
  }
  .opinion-comilla { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--c-acento); color: var(--sobre-acento); font-family: Georgia, "Times New Roman", serif; font-size: 3rem; line-height: 1; padding-top: 1.1rem; }
  .opinion-texto { margin-top: 1.5rem; flex: 1; font-size: clamp(1.15rem, 1.6vw, 1.35rem); line-height: 1.5; font-weight: 500; letter-spacing: -0.01em; }
</style>
