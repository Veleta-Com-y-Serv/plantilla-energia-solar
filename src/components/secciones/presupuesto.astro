---
// Presupuesto: fila partida a sangre en dos colores. A la izquierda, verde noche con rejilla de celdas: titular,
// `items` (garantías con icono en un sol) y `nota` («Sin compromiso»). A la derecha, banda amarilla sol con el
// formulario completo (nombre, teléfono, localidad, «¿Qué te interesa?» con los títulos de soluciones, lo que
// paga de luz y mensaje) que abre el correo. `boton_formulario` opcional.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
const botonForm = (s?.boton_formulario as string) || undefined;
---

{
  s && (
    <section id={id} class="partida">
      <div class="partida-texto banda-noche celdas presupuesto-lado">
        <div>
          <Titular class="!mb-9" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {items.length > 0 && (
            <ul class="grid gap-5">
              {items.map((it) => (
                <li class="flex items-start gap-4">
                  <span class="disco disco--pequeno"><Icono nombre={it.icono || 'check'} tam={18} /></span>
                  <div>
                    <p class="font-display text-lg font-extrabold tracking-tight">{it.titulo}</p>
                    {it.texto && <p class="opacity-80">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {s.nota && <p class="presupuesto-nota">{s.nota}</p>}
        </div>
      </div>
      <div class="partida-texto banda-sol presupuesto-form">
        <div>
          <FormularioContacto modelo="completo" prefijo={`${id}-f`} boton={botonForm} />
        </div>
      </div>
    </section>
  )
}

<style>
  .presupuesto-nota { display: inline-flex; margin-top: 2.25rem; padding: .55rem 1.1rem; border-radius: 999px; border: 2px dashed var(--c-acento); color: var(--c-acento); font-weight: 800; }
  .presupuesto-form :global(.formulario-aviso) { opacity: .8; }
  .presupuesto-form :global(.campo-check a) { font-weight: 700; }
  @media (min-width: 1024px) {
    .presupuesto-lado { display: flex; justify-content: flex-end; }
    .presupuesto-lado > div { width: 100%; max-width: 40rem; }
  }
</style>
